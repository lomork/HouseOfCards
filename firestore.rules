// Firestore security rules for House of Cards.
// Apply: Firebase Console -> Firestore Database -> Rules -> paste -> Publish
// (or deploy with `firebase deploy --only firestore:rules`).
//
// - A signed-in player can read/write ONLY their own "users/{uid}" document.
// - A brand-new document must start with 500 coins and zero stats.
// - Deletes are blocked (there is no `allow delete`), so a client can't wipe
//   its profile.
//
// Note: these rules stop one player editing another player's data. They do NOT
// stop a player from sending arbitrary increments to their OWN coins from a
// modified client — for that hard guarantee, route coin changes through a
// Cloud Function that verifies the win before writing (see README).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isOwner();

      // Every new account starts with 500 coins and zero stats.
      allow create: if isOwner()
        && request.resource.data.coins == 500
        && request.resource.data.totalWins == 0
        && request.resource.data.totalLosses == 0
        && request.resource.data.streak == 0;

      allow update: if isOwner();
    }
  }
}